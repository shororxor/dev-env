[global_config]
  window_state = maximise
[keybindings]
  zoom_in = <Primary>equal
  split_horiz = <Primary><Alt>h
  split_vert = <Primary><Alt>v
  layout_launcher = <Primary><Alt>l
[profiles]
  [[default]]
    icon_bell = False
    background_color = "#1e1e2e"
    background_darkness = 0.6
    background_type = transparent
    background_image = None
    font = MesloLGS Nerd Font 14
    foreground_color = "#cdd6f4"
    show_titlebar = False
    scrollbar_position = hidden
    scroll_on_keystroke = False
    scrollback_lines = 1000
    palette = "#45475a:#f38ba8:#a6e3a1:#f9e2af:#89b4fa:#f5c2e7:#94e2d5:#bac2de:#585b70:#f38ba8:#a6e3a1:#f9e2af:#89b4fa:#f5c2e7:#94e2d5:#a6adc8"
    use_system_font = False
    bold_is_bright = True
    title_hide_sizetext = True
    title_transmit_bg_color = "#ffffff"
    title_receive_bg_color = "#ffffff"
    title_inactive_fg_color = "#ffffff"
    title_inactive_bg_color = "#ffffff"
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
